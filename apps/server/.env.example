PORT=8080
DATABASE_URL="postgres://local:mypassword@localhost:5432/razorpayai"
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OpenAI
OPENAI_API_KEY=

# Email (Resend SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=recovery@yourdomain.com
PRODUCT_NAME = razorpayai

# Inngest
INNGEST_EVENT_KEY=your-event-key
INNGEST_SIGNING_KEY=your-signing-key
INNGEST_DEV=1
FAST_DEMO_MODE=true
ESCALATION_WAIT_TIME=10s 
